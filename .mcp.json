{
  "mcpServers": {
    "line": {
      "command": "bun",
      "args": [
        "run",
        "--cwd",
        "${CLAUDE_PLUGIN_ROOT}",
        "--shell=bun",
        "--silent",
        "start"
      ],
      "env": {
        "LINE_CHANNEL_ACCESS_TOKEN": "${user_config.line_channel_access_token}",
        "LINE_CHANNEL_SECRET": "${user_config.line_channel_secret}"
      }
    }
  }
}
